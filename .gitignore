# Isolated development worktrees (CLAUDE.md convention)
.worktrees/

# Subagent-driven-development scratch (briefs, reports, diffs, progress ledger)
.superpowers/

# Superpowers brainstorming/plans scratch (any skill subdir) — never commit
**/docs/superpowers/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

*.excalidraw

# Allow canonical test input fixtures (generated by tests/inputs/gen_inputs.py)
!skills/excalidraw-generation/tests/inputs/*.excalidraw
!skills/excalidraw-generation/tests/inputs/atomic/*.excalidraw
!skills/excalidraw-generation/tests/inputs/integration/*.excalidraw

skills/excalidraw-generation/tools/node_modules/

# Proprietary Apple font — extracted locally on macOS, never committed
# (uv run --with fonttools python tools/build_fonts.py --apple-emoji)
skills/excalidraw-generation/font_files/AppleColorEmoji.ttf
